# Port to listen on (default: 3000)
PORT=3000

# Path to the SQLite database file.
# On first run (file does not exist), the database is initialized.
# On subsequent runs, the existing database is opened.
DB_PATH=./stack.db

# Owner entity ID. Required only on first run when the DB is being initialized.
# Must be a DID (e.g. "did:key:z6Mk..."). Generate one with:
#   node -e "require('@haverstack/core/did').generateDidKeypair().then(k => console.log(k.did))"
# Keep the corresponding private key — this only prints the public DID.
ENTITY_ID=

# Owner's display name (optional). When set, the server ensures the owner's
# own _entity profile record exists on every open — safe to leave set
# permanently. No profile record is created if omitted.
OWNER_NAME=

# Owner's handle (optional). Only used alongside OWNER_NAME.
OWNER_HANDLE=

# IANA timezone string (optional). Used only on first run. No default — an
# absent timezone stays absent (omitted from discovery), rather than
# asserting a timezone the stack was never actually given.
TIMEZONE=

# Master bearer token for the stack owner. This is a break-glass credential:
# the DID challenge-response handshake lets a client holding the owner's key
# authenticate without it, but OWNER_TOKEN remains required to bootstrap the
# server and manage other tokens via POST /tokens. Keep this secret and
# treat it like a root password. All other tokens are issued via the API
# and stored in the DB.
# Generate with `openssl rand -hex 32`
OWNER_TOKEN=

# Allowed CORS origins. Default: empty (no cross-origin access).
# Set to * to allow all origins, or a comma-separated list:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# See docs/deployment.md for guidance.
CORS_ORIGINS=

# Canonical public base URL of this server. Required: it's the origin the
# DID challenge-response handshake (POST /auth/challenge, POST /auth/token)
# signs and verifies against, and MUST be this server's own public origin —
# never auto-detected from a request header, which a client controls.
# Example: https://stack.example.com
BASE_URL=

# Maximum upload size for attachments in bytes (default: 52428800 = 50 MB).
MAX_ATTACHMENT_BYTES=52428800

# Maximum size of a JSON request body in bytes — record bodies, PATCH merge
# patches, and every other JSON-accepting route (default: 1048576 = 1 MB).
# Applies globally, except POST /attachments, which is bounded by
# MAX_ATTACHMENT_BYTES instead. Declared to clients via maxContentBytes in
# GET /.well-known/stack.
MAX_CONTENT_BYTES=1048576

# Deadline in milliseconds for a GET /records or POST /records/query search
# (default: 10000 = 10s). Bounds execution only — the clock starts when the
# search reaches a worker, so waiting for a free worker makes a request slow,
# never failed. A query still executing past it is abandoned with 503 (code
# "timeout"). See docs/deployment.md#bounding-query-cost.
QUERY_TIMEOUT_MS=10000

# Number of worker threads a slow search can occupy without blocking other
# requests (default: 2, max 32). See docs/deployment.md#bounding-query-cost.
QUERY_WORKER_POOL_SIZE=2

# How many searches may queue for a free worker before the server sheds load
# with 503 (code "timeout") rather than queueing further (default: 64). This
# is what bounds the waiting that QUERY_TIMEOUT_MS deliberately does not.
# See docs/deployment.md#bounding-query-cost.
QUERY_QUEUE_LIMIT=64

# Register the Schema Commons types (org.haverstack/note, bookmark, task,
# contact, article, place, page, photo) from @haverstack/commons on startup
# (default: false). Off by default because the package is Draft status and
# registering types is not free — they show up in GET /types and in every
# app's type cache. See docs/deployment.md#schema-commons-seeding.
SEED_COMMONS_TYPES=false

# See docs/deployment.md for production deployment guidance (TLS, CORS,
# rate limiting, and public endpoint exposure).
